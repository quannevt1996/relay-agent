# Copy to .env and fill in what you need. Everything is optional for the demo:
# with no keys the app runs on fake Slack/Notion data and a scripted model.

# --- Model ---------------------------------------------------------------------
# Set to use Claude. Without it, a scripted stand-in drives the agent loop.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
# RELAY_EFFORT=medium
# Upper bound on model turns per run.
# RELAY_MAX_TURNS=12

# --- Server --------------------------------------------------------------------
# PORT=8787
# Public origin of this server. OAuth redirect URIs are built from it, so it must
# match what you register with Slack and Notion (an HTTPS tunnel for local OAuth).
# RELAY_PUBLIC_URL=http://localhost:8787
# Only needed when the web UI is served from a different origin than the API.
# RELAY_WEB_URL=
# RELAY_DATA_DIR=./data
# RELAY_SKILLS_DIR=./skills

# 32 random bytes, base64. Encrypts OAuth tokens at rest and signs session cookies.
# Generate with: openssl rand -base64 32
# Required when NODE_ENV=production; otherwise a key is generated in RELAY_DATA_DIR.
RELAY_ENCRYPTION_KEY=

# --- Connectors ----------------------------------------------------------------
# demo | live. Defaults to live when any OAuth client below is set, demo otherwise.
# CONNECTOR_MODE=

# Slack app credentials (Basic Information page of your Slack app).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion public integration OAuth credentials.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- MCP server ----------------------------------------------------------------
# In live mode, the workspace whose connections the MCP server uses.
# GET /api/session in the browser shows your workspace id.
# RELAY_WORKSPACE_ID=
